<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      netstandard2.1, which is what SPT 4.1 client plugins target. This was v4.7.2 in the
      old-style project, the 4.0-era shape.
    -->
    <TargetFramework>netstandard2.1</TargetFramework>
    <OutputType>Library</OutputType>
    <RootNamespace>BetterThermal</RootNamespace>
    <AssemblyName>BetterThermalNightVision</AssemblyName>
    <LangVersion>latest</LangVersion>

    <!--
      The old project listed Properties\AssemblyInfo.cs in its Compile items, but no such
      file has ever been in the repository - the build only worked because MSBuild does not
      mind a missing Compile item until the compiler asks for it. SDK projects generate the
      assembly attributes instead, from here. 1.3.2 is the version the BepInPlugin
      attribute declares.
    -->
    <Version>1.3.2</Version>
    <AssemblyVersion>1.3.2</AssemblyVersion>
    <FileVersion>1.3.2</FileVersion>
    <Product>Better Thermal &amp; Night Vision</Product>
    <AssemblyTitle>BetterThermalNightVision</AssemblyTitle>

    <OutputPath>bin\$(Configuration)\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <Deterministic>true</Deterministic>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
  </PropertyGroup>

  <!--
    Every HintPath used to be a hardcoded D:\EFT408\..., so the project only built on the
    one machine it was written on. SptRoot replaces that and can be overridden per machine
    with -p:SptRoot=... or an SptRoot environment variable.
  -->
  <PropertyGroup>
    <SptRoot Condition=" '$(SptRoot)' == '' ">E:\SPT 4.1</SptRoot>
    <SptManaged>$(SptRoot)\EscapeFromTarkov_Data\Managed</SptManaged>
    <SptBepInEx>$(SptRoot)\BepInEx</SptBepInEx>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="0Harmony">
      <HintPath>$(SptBepInEx)\core\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="BepInEx">
      <HintPath>$(SptBepInEx)\core\BepInEx.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(SptManaged)\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Assembly-CSharp-firstpass">
      <HintPath>$(SptManaged)\Assembly-CSharp-firstpass.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!--
      Not referenced by the old project. CameraManager and OpticCameraManager reach into
      Comfort.Common in their own signatures, and touching them without this can fail with
      CS0012 rather than anything that names the real problem.
    -->
    <Reference Include="Comfort">
      <HintPath>$(SptManaged)\Comfort.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Unity.Postprocessing.Runtime">
      <HintPath>$(SptManaged)\Unity.Postprocessing.Runtime.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(SptManaged)\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(SptManaged)\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.ImageConversionModule">
      <HintPath>$(SptManaged)\UnityEngine.ImageConversionModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!--
    Fail with the reason rather than with a wall of "type or namespace not found".
  -->
  <Target Name="EnsureSptRoot" BeforeTargets="BeforeBuild;ResolveAssemblyReferences">
    <Error Condition="!Exists('$(SptManaged)\Assembly-CSharp.dll')"
           Text="SptRoot '$(SptRoot)' does not look like an SPT install (missing EscapeFromTarkov_Data\Managed\Assembly-CSharp.dll). Pass -p:SptRoot=... or set the SptRoot environment variable." />
  </Target>

  <!--
    The plugin reads ColorRamp.png out of its own directory (Info.Location), so the DLL and
    the png have to land together - hence a folder under plugins\ rather than a loose DLL.
  -->
  <PropertyGroup>
    <PluginFolderName>BetterThermalNightVision</PluginFolderName>
  </PropertyGroup>

  <Target Name="CopyToSPT" AfterTargets="Build" Condition="Exists('$(SptRoot)')">
    <MakeDir Directories="$(SptBepInEx)\plugins\$(PluginFolderName)" />
    <Copy SourceFiles="$(TargetPath);$(ProjectDir)ColorRamp.png"
          DestinationFolder="$(SptBepInEx)\plugins\$(PluginFolderName)" />
  </Target>

  <!--
    The zip must NOT live inside the directory being zipped. ZipDirectory archives the
    CONTENTS of SourceDirectory, so the staged tree has to be the folder holding BepInEx\
    for the archive to unpack over an SPT install - and pointing DestinationFile at that
    same folder makes the task read the file it is currently writing (MSB3931, "file is in
    use by another process" - the other process being this one). Staging one level down
    fixes it and lets RemoveDir clear the tree without hitting a locked archive.
  -->
  <PropertyGroup>
    <ReleaseDir>$(ProjectDir)Release</ReleaseDir>
    <ReleaseStagingDir>$(ReleaseDir)\staging</ReleaseStagingDir>
  </PropertyGroup>

  <Target Name="PackageRelease" AfterTargets="CopyToSPT">
    <RemoveDir Directories="$(ReleaseStagingDir)" />
    <Copy SourceFiles="$(TargetPath);$(ProjectDir)ColorRamp.png"
          DestinationFolder="$(ReleaseStagingDir)\BepInEx\plugins\$(PluginFolderName)" />
    <ZipDirectory SourceDirectory="$(ReleaseStagingDir)"
                  DestinationFile="$(ReleaseDir)\BetterNightThermalVision.zip"
                  Overwrite="true" />
    <Message Text="Release zip: $(ReleaseDir)\BetterNightThermalVision.zip" Importance="high" />
  </Target>

  <ItemGroup>
    <None Include="ColorRamp.png" />
  </ItemGroup>

</Project>
